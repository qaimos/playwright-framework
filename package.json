{
  "name": "playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Full-featured Playwright test automation framework (TypeScript)",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:ci": "npx playwright test --reporter=line,json",
    "test:debug": "npx playwright test --debug",
    "report": "npx playwright show-report",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
